{
  "name": "txt-reader",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "本地电子书阅读器（TXT / EPUB / PDF），Electron + React + TypeScript",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:web": "vite build",
    "build": "npm run build:main && npm run build:web",
    "start": "node scripts/start.mjs",
    "smoke": "node scripts/smoke.mjs",
    "package": "node scripts/package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
